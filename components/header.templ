package components

templ Header(name string) {
	<header class="sticky top-0 z-50 h-12 border-b border-line bg-void/90 backdrop-blur-md">
		<div class="mx-auto flex h-full max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
			<a
				href="/"
				class="group flex min-w-0 items-center gap-2"
				aria-label={ "0xVIVA, " + name }
			>
				<span aria-hidden="true" class="text-sm text-acid">{ ">_" }</span>
				<span class="text-xs tracking-[0.18em] text-fg transition-colors group-hover:text-acid">0xVIVA</span>
			</a>

			<nav aria-label="Primary" class="flex items-center gap-3 sm:gap-5">
				<a href="#commits" class="text-[10px] tracking-[0.14em] text-muted transition-colors hover:text-acid">commits</a>
				<a
					href="https://github.com/0xViva"
					target="_blank"
					rel="noopener noreferrer"
					aria-label="GitHub"
					class="group flex items-center gap-1.5 text-[10px] tracking-[0.14em] text-muted transition-colors hover:text-acid"
				>
					<img src="/assets/svg/github.svg" alt="" aria-hidden="true" class="size-3.5 invert opacity-70 transition-opacity group-hover:opacity-100"/>
					<span class="hidden sm:inline">GitHub</span>
				</a>
				<a
					href="https://www.linkedin.com/in/august-justinus-gran"
					target="_blank"
					rel="noopener noreferrer"
					aria-label="LinkedIn"
					class="group flex items-center gap-1.5 text-[10px] tracking-[0.14em] text-muted transition-colors hover:text-acid"
				>
					<img src="/assets/svg/linkedin.svg" alt="" aria-hidden="true" class="size-3.5 invert opacity-70 transition-opacity group-hover:opacity-100"/>
					<span class="hidden sm:inline">LinkedIn</span>
				</a>
				<a
					href="mailto:0xViva@proton.me"
					aria-label="Email"
					class="group flex items-center gap-1.5 text-[10px] tracking-[0.14em] text-muted transition-colors hover:text-acid"
				>
					<img src="/assets/svg/email.svg" alt="" aria-hidden="true" class="size-3.5 invert opacity-70 transition-opacity group-hover:opacity-100"/>
					<span class="hidden sm:inline">email</span>
				</a>

				<span class="hidden text-[10px] tabular-nums tracking-[0.08em] text-dim md:inline" data-hud-clock>--:--:-- UTC</span>
			</nav>
		</div>
	</header>
}
