package components

templ Footer() {
	<footer class="mt-auto border-t border-line">
		<div class="mx-auto flex max-w-7xl flex-col gap-2 px-4 py-6 text-[11px] text-muted sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8">
			<p>© 1998-2026 August J. Gran</p>
			<p>Built with Go, Echo, templ, htmx, and Tailwind CSS.</p>
		</div>
	</footer>
}
