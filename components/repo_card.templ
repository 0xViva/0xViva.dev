package components

import (
	"fmt"
	"strconv"

	"github.com/0xViva/0xViva.dev/ui"
)

templ RepoCard(repo GitHubRepo, index int) {
	{{ segments := ui.LanguageSegments(repo.Languages) }}
	<article
		class="repo-card group relative flex h-full flex-col overflow-hidden border border-line p-5 transition-[border-color,translate] duration-200 hover:-translate-y-0.5 hover:border-acid/70 sm:p-6"
		style={ "animation-delay:" + strconv.Itoa(max(0, index-1)*60) + "ms" }
	>
		<span aria-hidden="true" class="pointer-events-none absolute left-0 top-0 size-4 border-l border-t border-acid/60"></span>
		<span aria-hidden="true" class="pointer-events-none absolute bottom-0 right-0 size-4 border-b border-r border-acid/60"></span>

		<header class="relative flex items-start justify-between gap-3">
			<span class="text-[10px] tracking-[0.18em] text-dim">{ ui.RepoIndex(index) }</span>
			<div class="flex flex-wrap justify-end gap-1">
				if repo.Visibility == "private" {
					<span class="inline-flex items-center gap-1 border border-magenta/40 bg-magenta/5 px-1.5 py-0.5 text-[9px] uppercase tracking-[0.18em] text-magenta">
						<img src="/assets/svg/locked.svg" alt="" aria-hidden="true" class="size-3"/>
						private
					</span>
				} else {
					<span class="inline-flex items-center gap-1 border border-line px-1.5 py-0.5 text-[9px] uppercase tracking-[0.18em] text-muted">
						<img src="/assets/svg/unlocked.svg" alt="" aria-hidden="true" class="size-3"/>
						public
					</span>
				}
				if repo.Owner.Login == "0xViva" {
					<span class="inline-flex items-center gap-1 border border-line px-1.5 py-0.5 text-[9px] uppercase tracking-[0.18em] text-muted">
						<img src="/assets/svg/personal.svg" alt="" aria-hidden="true" class="size-3"/>
						owned
					</span>
				} else {
					<span class="inline-flex items-center gap-1 border border-cyan/30 bg-cyan/5 px-1.5 py-0.5 text-[9px] uppercase tracking-[0.18em] text-cyan">
						<img src="/assets/svg/collab.svg" alt="" aria-hidden="true" class="size-3"/>
						collab
					</span>
				}
			</div>
		</header>

		<h3 class="relative mt-4 flex min-w-0 items-center gap-2 text-lg leading-tight text-fg">
			<img src="/assets/svg/github.svg" alt="" aria-hidden="true" class="size-4 shrink-0 invert opacity-70"/>
			<span class="min-w-0 break-all">
				<span class="text-sm text-dim">{ repo.Owner.Login }</span>
				<span class="text-dim">/</span>
				<a
					href={ templ.SafeURL(repo.HTMLURL) }
					target="_blank"
					rel="noopener noreferrer"
					class="hover:text-acid"
				>{ repo.Name }</a>
			</span>
		</h3>

		if repo.Description == "" {
			<p class="relative mt-2 text-sm leading-relaxed text-dim">No description.</p>
		} else {
			<p class="relative mt-2 line-clamp-3 text-sm leading-relaxed text-muted">{ repo.Description }</p>
		}

		<div class="relative mt-5">
			<div class="flex items-center justify-between text-[9px] uppercase tracking-[0.18em] text-dim">
				<span>languages</span>
				if repo.Language != "" {
					<span>{ repo.Language }</span>
				}
			</div>
			<div class="mt-2 flex h-1.5 w-full overflow-hidden bg-line" aria-hidden="true">
				for _, segment := range segments {
					<div style={ "width:" + strconv.FormatFloat(segment.Percent, 'f', 2, 64) + "%;background-color:" + segment.Color }></div>
				}
			</div>
			if len(segments) > 0 {
				<ul class="mt-2 flex flex-wrap gap-x-3 gap-y-1 text-[10px] text-muted">
					for i, segment := range segments {
						if i < 3 {
							<li class="flex items-center gap-1.5">
								<span class="size-1.5 shrink-0" style={ "background-color:" + segment.Color } aria-hidden="true"></span>
								<span>{ segment.Name }</span>
								<span class="text-dim">{ fmt.Sprintf("%.1f%%", segment.Percent) }</span>
							</li>
						}
					}
				</ul>
			} else {
				<p class="mt-2 text-[10px] text-dim">No language data.</p>
			}
		</div>

		<div class="relative mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 border-t border-line pt-3 text-[10px] text-muted">
			<span class="inline-flex items-center gap-1" title="Stars">
				<svg viewBox="0 0 16 16" class="size-3" fill="currentColor" aria-hidden="true">
					<path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"></path>
				</svg>
				<span class="sr-only">Stars</span>
				{ strconv.Itoa(repo.Stars) }
			</span>
			<span class="inline-flex items-center gap-1" title="Forks">
				<svg viewBox="0 0 16 16" class="size-3" fill="currentColor" aria-hidden="true">
					<path d="M5 5.372v.878c0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75v-.878a2.25 2.25 0 1 1 1.5 0v.878a2.25 2.25 0 0 1-2.25 2.25h-1.5v2.128a2.251 2.251 0 1 1-1.5 0V8.5h-1.5A2.25 2.25 0 0 1 3.5 6.25v-.878a2.25 2.25 0 1 1 1.5 0ZM5 3.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm6.75.75a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm-3 8.75a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Z"></path>
				</svg>
				<span class="sr-only">Forks</span>
				{ strconv.Itoa(repo.Forks) }
			</span>
			<span class="inline-flex items-center gap-1" title="Branches">
				<img src="/assets/svg/branch.svg" alt="" aria-hidden="true" class="size-3 opacity-70"/>
				<span class="sr-only">Branches</span>
				{ strconv.Itoa(len(repo.Branches)) }
			</span>
			<span class="ml-auto">updated { ui.TimeAgo(repo.UpdatedAt) }</span>
		</div>

		<div class="relative mt-4 border-t border-line pt-3">
			<p class="flex items-center gap-1.5 text-[9px] uppercase tracking-[0.2em] text-dim">
				<img src="/assets/svg/commit.svg" alt="" aria-hidden="true" class="size-3 opacity-70"/>
				commits
			</p>
			if len(repo.Commits) == 0 {
				<p class="mt-2 text-[11px] text-dim">No recent commits.</p>
			} else {
				<ol class="mt-2 space-y-1.5">
					for i, commit := range repo.Commits {
						if i < 3 {
							<li class="flex items-baseline gap-2 text-[11px]">
								<a
									href={ templ.SafeURL(commit.HTMLURL) }
									target="_blank"
									rel="noopener noreferrer"
									class="shrink-0 text-cyan/80 hover:text-cyan"
								>{ ui.ShortSHA(commit.SHA) }</a>
								if repo.Visibility == "private" {
									<span class="flex min-w-0 flex-1 items-center gap-1.5 text-dim">
										<img src="/assets/svg/locked.svg" alt="" aria-hidden="true" class="size-3 opacity-70"/>
										<span>private commit</span>
									</span>
								} else {
									<span class="min-w-0 flex-1 truncate text-muted" title={ commit.Message }>{ ui.CommitMessage(commit.Message) }</span>
								}
								<span class="shrink-0 text-acid">+{ strconv.Itoa(commit.Additions) }</span>
								<span class="shrink-0 text-magenta">-{ strconv.Itoa(commit.Deletions) }</span>
							</li>
						}
					}
				</ol>
			}
		</div>

		<a
			href={ templ.SafeURL(repo.HTMLURL) }
			target="_blank"
			rel="noopener noreferrer"
			class="relative mt-auto flex items-center gap-2 border-t border-line pt-3 text-[10px] tracking-[0.18em] text-muted transition-colors hover:text-acid"
		>
			<img src="/assets/svg/github.svg" alt="" aria-hidden="true" class="size-3.5 invert"/>
			<span>View on GitHub</span>
		</a>
	</article>
}
