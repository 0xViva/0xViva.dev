package views

templ Home(title string, name string, cssVersion string) {
	@Layout(title, name, cssVersion) {
		<section class="mx-auto max-w-7xl px-4 pb-12 pt-10 sm:px-6 sm:pt-14 lg:px-8 lg:pb-16 lg:pt-20">
			<div class="flex flex-col border border-line bg-panel/80">
				<div class="flex shrink-0 items-center justify-between gap-3 border-b border-line px-3 py-2 sm:px-4">
					<div class="flex min-w-0 items-center gap-3">
						<div class="flex shrink-0 gap-1.5" aria-hidden="true">
							<span class="size-2 rounded-full bg-magenta/80"></span>
							<span class="size-2 rounded-full bg-amber/80"></span>
							<span class="size-2 rounded-full bg-acid/80"></span>
						</div>
						<p class="truncate text-[10px] tracking-[0.12em] text-dim">ajg@0xviva.dev</p>
					</div>
					<span class="shrink-0 text-[10px] uppercase tracking-[0.16em] text-dim">bash</span>
				</div>

				<div class="hero-body flex flex-col p-4 sm:p-6 lg:p-8">
					<p class="text-xs sm:text-sm">@terminalPrompt("whoami")</p>

					<h1 class="mt-3">
						<span class="sr-only">{ name }</span>
						<span aria-hidden="true" class="hero-name block uppercase leading-[0.88] tracking-[-0.06em] text-fg">
							<span class="block">AUGUST</span>
							<span class="block">JUSTINUS GRAN</span>
						</span>
					</h1>

					<p class="mt-6 text-xs sm:text-sm">@terminalPrompt("cat ./README.md")</p>

					<div class="mt-3 max-w-[60ch] space-y-3 text-sm leading-relaxed text-muted">
						<p>I like to build software that is small in size and runs really fast on all kinds of hardware, locally and in the cloud.</p>
						<p>I've enjoyed C#, Python, Rust, Go, and TypeScript. In that order. I've concluded that all programming is good.</p>
						<p>I care about my tools and working efficiently with keyboards on modern terminals. Performance matters, always.</p>
						<p>Currently working on software for Norwegian IT companies and myself.</p>
					</div>

					<div class="mt-7 flex flex-col gap-2.5 sm:flex-row sm:flex-wrap">
						<a
							href="https://github.com/0xViva"
							target="_blank"
							rel="noopener noreferrer"
							class="cut cut-primary inline-flex items-center justify-center gap-2.5 px-4 py-2.5 text-[11px] tracking-[0.12em] text-void transition-colors sm:justify-start"
						>
							<img src="/assets/svg/github.svg" alt="" aria-hidden="true" class="size-4"/>
							<span>GitHub</span>
						</a>
						<a
							href="https://www.linkedin.com/in/august-justinus-gran"
							target="_blank"
							rel="noopener noreferrer"
							class="cut cut-outline group inline-flex items-center justify-center gap-2.5 px-4 py-2.5 text-[11px] tracking-[0.12em] text-fg transition-colors hover:text-cyan sm:justify-start"
						>
							<img src="/assets/svg/linkedin.svg" alt="" aria-hidden="true" class="size-4 invert opacity-70 transition-opacity group-hover:opacity-100"/>
							<span>LinkedIn</span>
						</a>
						<a
							href="https://teknologipunktet.no"
							target="_blank"
							rel="noopener noreferrer"
							class="cut cut-outline group inline-flex items-center justify-center gap-2.5 px-4 py-2.5 text-[11px] tracking-[0.12em] text-fg transition-colors hover:text-cyan sm:justify-start"
						>
							<img
								src="/assets/png/teknologipunktet-logo.png"
								alt=""
								class="h-4 w-auto grayscale transition group-hover:grayscale-0"
							/>
							<span>teknologipunktet.no</span>
						</a>
						<a
							href="mailto:0xViva@proton.me"
							class="cut cut-ghost group inline-flex items-center justify-center gap-2.5 px-4 py-2.5 text-[11px] tracking-[0.12em] text-muted transition-colors hover:text-fg sm:justify-start"
						>
							<img src="/assets/svg/email.svg" alt="" aria-hidden="true" class="size-4 invert opacity-70 transition-opacity group-hover:opacity-100"/>
							<span>Email</span>
						</a>
					</div>

					<p class="mt-7 text-sm" aria-hidden="true">
						@terminalPrompt("")
						<span class="cursor-block"></span>
					</p>
				</div>
			</div>
		</section>

		@cliTicker()

		<section id="commits" class="scroll-mt-20 border-t border-line bg-ink/20">
			<div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
				<div class="flex flex-wrap items-end justify-between gap-4">
					<div>
						<p class="text-[10px] tracking-[0.18em] text-dim">github.com/0xViva</p>
						<h2 class="mt-2 text-2xl uppercase tracking-[0.08em] text-fg sm:text-3xl">COMMIT FEED</h2>
					</div>
					<span class="inline-flex items-center gap-1.5 border border-acid/30 px-2 py-1 text-[9px] tracking-[0.2em] text-acid">
						<span class="led" aria-hidden="true"></span>live
					</span>
				</div>
				<hr class="mt-5 h-px w-full border-0 bg-line"/>
				<p class="mt-5 max-w-2xl text-sm leading-relaxed text-muted">
					Recent repositories and commits from GitHub.
				</p>

				<div
					id="repos"
					class="mt-8"
					hx-get="/browse-repos"
					hx-trigger="load"
					hx-target="#repos"
				>
					<div class="border border-line p-6" role="status" aria-live="polite">
						<div class="flex items-center gap-2.5">
							<span class="led" aria-hidden="true"></span>
							<p class="text-[10px] tracking-[0.22em] text-muted">Loading commits...</p>
						</div>
						<div class="load-bar mt-4 h-1 w-full overflow-hidden bg-line" aria-hidden="true"></div>
						<noscript>
							<p class="mt-4 text-xs text-muted">
								JavaScript is off. <a href="/browse-repos" class="text-acid underline underline-offset-4">Open the commit feed directly</a>.
							</p>
						</noscript>
					</div>
				</div>
			</div>
		</section>
	}
}

templ terminalPrompt(command string) {
	<span class="text-acid">ajg@0xviva.dev</span><span class="text-dim">:</span><span class="text-cyan">~</span><span class="text-dim">$</span>
	if command != "" {
		<span class="text-fg"> { command }</span>
	}
}

templ cliTicker() {
	{{ commands := []string{"grep", "rg", "sed", "awk", "find", "xargs", "jq", "curl", "ssh", "rsync", "tmux", "vim", "fzf", "git", "tar", "ps", "htop", "lsof", "ss", "dig", "strace", "systemctl", "journalctl", "man"} }}
	<div class="ticker border-y border-line bg-ink/60">
		<p class="sr-only">Linux and CLI commands: grep, rg, sed, awk, find, xargs, jq, curl, ssh, rsync, tmux, vim, fzf, git, tar, ps, htop, lsof, ss, dig, strace, systemctl, journalctl, man.</p>
		<div class="ticker-track flex w-max py-3" aria-hidden="true">
			@commandGroup(commands)
			@commandGroup(commands)
		</div>
	</div>
}

templ commandGroup(commands []string) {
	<div class="flex shrink-0 items-center gap-6 pr-6">
		for _, command := range commands {
			<span class="text-[10px] tracking-[0.12em] text-muted">{ command }</span>
			<span aria-hidden="true" class="text-acid/40">{ "//" }</span>
		}
	</div>
}
